# ==============================================================================
# IncuBrix Growth Engine - Environment Configuration Template
# ==============================================================================
# Option 1: Vertex AI via Google Cloud ADC (Recommended for GCP projects)
# 1. Run: gcloud auth application-default login
# 2. Set USE_VERTEX_AI=true, GCP_PROJECT_ID, and GCP_LOCATION below.
#
# Option 2: Direct Gemini API Key (Alternative)
# 1. Obtain key at: https://aistudio.google.com/app/apikey
# 2. Set USE_VERTEX_AI=false and supply GEMINI_API_KEY.
# ==============================================================================

USE_VERTEX_AI=true
GCP_PROJECT_ID=smart-industrial-edge-ai-dev
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Fallback API Key (Leave empty if USE_VERTEX_AI=true)
GEMINI_API_KEY=

# Engine Execution Defaults
MAX_GENERATION_WORKERS=4
DEFAULT_BASE_URL=https://incubrix.com
CAMPAIGN_NAME=growth_engine_q1
OUTPUT_DIR=data/outputs
ASSET_EXPORT_DIR=assets/final
